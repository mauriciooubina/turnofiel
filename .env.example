# PFI Configuration Settings
HELLFISH_SALT=<sal-secreta-hellfish>
HOOLIGANS_SALT=<sal-secreta-hooligans>

# Backend Server configurations
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Data Source Feature Flag ("POSTGRES" or "CSV")
DATA_SOURCE=POSTGRES

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pfi_db
DB_USER=postgres
DB_PASS=<contraseña-de-postgres>

# Login
JWT_SECRET=
ADMIN_PASSWORD=
HELLFISH_PASSWORD=
HOOLIGANS_PASSWORD=

APP_DB_USER=pfi_app
APP_DB_PASS=<una contraseña de 12+ caracteres>